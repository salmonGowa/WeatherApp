# Copy to backend/backend/.env — every value is optional.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL (remove DATABASE_NAME to use SQLite; the API itself is stateless)
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Shared cache for multi-worker deployments
REDIS_URL=

# External services (defaults are the free public endpoints)
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
TRUCK_MAX_SPEED_MPH=65
